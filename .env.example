APP_NAME=NotificationService
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

PHP_VERSION=8.5.0
LARAVEL_VERSION=13.0.0
LARAVEL_OCTANE_VERSION=3.0.0
SWOOLE_VERSION=6.0.2
GO_VERSION=1.24.4

POSTGRES_VERSION=17.5
POSTGRES_DB=notification_service
POSTGRES_USER=notification
POSTGRES_PASSWORD=notification
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_VERSION=7.4.2
REDIS_HOST=redis
REDIS_PORT=6379

RABBITMQ_VERSION=4.1.1-management
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=notification
RABBITMQ_PASSWORD=notification
RABBITMQ_VHOST=notification

VICTORIAMETRICS_VERSION=1.102.1
VICTORIAMETRICS_URL=http://victoriametrics:8428
GRAFANA_VERSION=11.5.2
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

SERVICE_HTTP_PORT=8080
SMS_PROVIDER_URL=http://smsprovider:8081
EMAIL_PROVIDER_URL=http://emailprovider:8082
SMS_PROVIDER_PORT=8081
EMAIL_PROVIDER_PORT=8082

IDEMPOTENCY_TTL_HOURS=24
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BACKOFF_SECONDS=30,120,300,900,1800
RABBITMQ_PREFETCH=10
OCTANE_WORKERS=4
OCTANE_MAX_REQUESTS=500

