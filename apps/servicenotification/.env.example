APP_NAME=NotificationService
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_LEVEL=debug
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=notification_service
DB_USERNAME=notification
DB_PASSWORD=notification
DB_SSLMODE=prefer

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=sync

CACHE_STORE=redis
CACHE_PREFIX=notification_service

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=notification
RABBITMQ_PASSWORD=notification
RABBITMQ_VHOST=notification
RABBITMQ_PREFETCH=10
RABBITMQ_CONNECTION_TIMEOUT=3
RABBITMQ_READ_WRITE_TIMEOUT=3
RABBITMQ_HEARTBEAT=30
RABBITMQ_PUBLISH_CONFIRM_TIMEOUT=5
RABBITMQ_NOTIFICATIONS_EXCHANGE=notifications.exchange
RABBITMQ_RETRY_EXCHANGE=notifications.retry.exchange
RABBITMQ_DEAD_LETTER_EXCHANGE=notifications.dlx
RABBITMQ_SMS_QUEUE=notifications.sms.send
RABBITMQ_EMAIL_QUEUE=notifications.email.send
RABBITMQ_RETRY_QUEUE=notifications.retry
RABBITMQ_DLQ=notifications.dlq
RABBITMQ_SMS_ROUTING_KEY=notifications.sms.send
RABBITMQ_EMAIL_ROUTING_KEY=notifications.email.send
RABBITMQ_DLQ_ROUTING_KEY=notifications.dlq
RABBITMQ_RETRY_BACKOFF_SECONDS=30,120,300,900,1800

OCTANE_SERVER=swoole
OCTANE_HOST=0.0.0.0
OCTANE_PORT=8080
OCTANE_WORKERS=4
OCTANE_MAX_REQUESTS=500
OCTANE_MAX_EXECUTION_TIME=30
OCTANE_GARBAGE_MB=50
OUTBOX_PUBLISH_LIMIT=100
OUTBOX_PUBLISH_INTERVAL_SECONDS=2

SMS_PROVIDER_URL=http://smsprovider:8081
EMAIL_PROVIDER_URL=http://emailprovider:8082
SMS_PROVIDER_TIMEOUT_SECONDS=3
EMAIL_PROVIDER_TIMEOUT_SECONDS=3

IDEMPOTENCY_TTL_HOURS=24
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BACKOFF_SECONDS=30,120,300,900,1800

METRICS_ENABLED=true
METRICS_PATH=/metrics
VICTORIAMETRICS_URL=http://victoriametrics:8428
HTTP_LATENCY_BUCKETS=0.005,0.01,0.025,0.05,0.1,0.25,0.5,1,2.5,5,10
PROVIDER_LATENCY_BUCKETS=0.01,0.025,0.05,0.1,0.25,0.5,1,2.5,5,10
QUEUE_LAG_BUCKETS=0.1,0.5,1,5,15,30,60,300,900
